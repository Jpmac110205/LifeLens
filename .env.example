# Optional: set this for a backend on a different origin in production.
# Leave unset in development to use Vite's /api proxy to port 8080.
# VITE_API_URL=https://your-backend.example.com

# Server only. Never prefix an API key with VITE_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
# Comma-separated frontend origins when calling the backend directly.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
